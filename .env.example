# Kopieren nach .env.local und Werte eintragen. Nie committen.
# Anon- bzw. Publishable-Key des Projekts tpos-pilot. Kein Service-Role-Key im Web-Code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AP-69 KI Zuordnung (JEV, TypeSafe) ueber OpenRouter. Betreiber-Notaus:
# JEV laeuft nur mit JEV_ENABLED=true UND einem Key, unabhaengig vom
# Team-Schalter (app.module_flags jev_squad_check_enabled, nur admin).
# Nur serverseitig, nie mit NEXT_PUBLIC_ Praefix. Nie echte Keys ins Repo.
# JEV_MODEL muss dem in app.rpc_squad_check_jev_context festgeschriebenen
# Modell entsprechen, sonst faellt die Pruefung auf die Regel v1 zurueck.
JEV_ENABLED=false
JEV_PROVIDER=openrouter
JEV_MODEL=typesafe/jev-1.13
OPENROUTER_API_KEY=
JEV_TIMEOUT_MS=3000
JEV_MIN_CONFIDENCE=0.7
